# ============ XiaoZhi Server ============
# OTA / activation API URL
XIAOZHI_OTA_URL=https://api.tenclass.net/xiaozhi/ota/
# Device MAC address (auto-detected if empty)
XIAOZHI_DEVICE_ID=
# Client UUID (auto-generated if empty)
XIAOZHI_CLIENT_ID=

# ============ Audio ============
# ALSA input device name
ALSA_INPUT_DEVICE=default
# ALSA output device name
ALSA_OUTPUT_DEVICE=default
# Input sample rate
AUDIO_INPUT_SAMPLE_RATE=16000
# Output sample rate (XiaoZhi server uses 24000)
AUDIO_OUTPUT_SAMPLE_RATE=24000
# Silence appended before closing playback, to avoid clipped TTS tails.
AUDIO_OUTPUT_TAIL_PADDING_MS=120
# Max seconds to wait for sox/ALSA to drain after TTS stop.
AUDIO_OUTPUT_DRAIN_TIMEOUT_SEC=4

# Allow sustained user speech to interrupt assistant TTS playback.
BARGE_IN_ENABLED=false
# Raw PCM RMS threshold; raise this if speaker echo causes false triggers.
BARGE_IN_MIN_RMS=850
# Consecutive 60 ms frames required before interrupting.
BARGE_IN_REQUIRED_FRAMES=4
# Ignore/learn the initial speaker echo for this many milliseconds.
BARGE_IN_WARMUP_MS=350

# ============ Wake Word ============
# Enable wake word detection
WAKE_WORD_ENABLED=false
# Comma-separated list of wake word names or model paths
WAKE_WORDS=hey_jarvis
# Detection threshold (0.0 - 1.0)
WAKE_WORD_THRESHOLD=0.5
# Cooldown seconds between detections
WAKE_WORD_COOLDOWN_SEC=1.5

# ============ Display ============
# LCD backlight brightness (0-100)
LCD_BRIGHTNESS=100
# Font path (leave empty for default)
FONT_PATH=
# Text scroll pixels per rendered frame.
DISPLAY_SCROLL_SPEED=1.0
# UI style: classic, watercolor or robot
DISPLAY_UI_STYLE=classic
# Rust 3D robot workstation: target FPS and idle seconds before sleeping.
ROBOT_FPS=30
ROBOT_SLEEP_AFTER=45
# Occasional cosmetic fire/extinguisher and cloud/rain/umbrella scenes.
ROBOT_EVENTS_ENABLED=true
# Watercolor orb performance/quality settings (used only in watercolor mode)
WATERCOLOR_FPS=8
WATERCOLOR_DIAMETER=168
WATERCOLOR_RENDER_SCALE=0.37
WATERCOLOR_SMOOTH_FBM=false
WATERCOLOR_TEMPORAL_3D=false
# Assistant audio deformation and pigment travel gains (0.5-5.0).
WATERCOLOR_AUDIO_REACTIVITY=3.6
WATERCOLOR_SPEECH_MOTION=4.5
# Rust renderer worker threads. Two is recommended on Zero 2 W.
WATERCOLOR_THREADS=2
# Minimum time each watercolor caption page remains visible.
WATERCOLOR_CAPTION_PAGE_SECONDS=3.0
# Watercolor caption font size in pixels.
WATERCOLOR_CAPTION_FONT_SIZE=15
# Horizontal caption calibration in pixels; positive moves text right.
WATERCOLOR_CAPTION_OFFSET_X=3

# ============ Battery ============
# PiSugar battery monitor
PISUGAR_ENABLED=true
PISUGAR_HOST=127.0.0.1
PISUGAR_PORT=8423
# Battery polling interval in seconds
BATTERY_POLL_INTERVAL=5

# ============ MCP Local Command Tool ============
# Expose an allowlisted local command runner to XiaoZhi.
XIAOZHI_LOCAL_COMMAND_TOOL_ENABLED=true
# Comma-separated executable names allowed by the local_command tool.
XIAOZHI_LOCAL_COMMAND_ALLOWLIST=date,uptime,hostname,whoami,df,free,ip,iwgetid,vcgencmd
# Set true only on trusted networks/devices; this allows any executable.
XIAOZHI_LOCAL_COMMAND_UNSAFE=false
# Set true only with UNSAFE=true; this enables shell syntax like pipes and &&.
XIAOZHI_LOCAL_COMMAND_USE_SHELL=false
# Max seconds per command; requested timeouts are capped by this value.
XIAOZHI_LOCAL_COMMAND_TIMEOUT_SEC=5
# Minimum seconds between running-job checkCommand responses.
XIAOZHI_LOCAL_COMMAND_CHECK_INTERVAL_SEC=5
# Max stdout/stderr characters returned to the model.
XIAOZHI_LOCAL_COMMAND_OUTPUT_LIMIT=4000

# ============ MCP Web Tools ============
# Expose fetch_webpage and web_search tools to XiaoZhi.
XIAOZHI_WEB_TOOLS_ENABLED=true
# Optional proxy for web tools, e.g. http://127.0.0.1:7897 or socks5://127.0.0.1:7897.
# If empty, HTTPS_PROXY/HTTP_PROXY/ALL_PROXY are used when present.
XIAOZHI_WEB_TOOL_PROXY=
# HTTP request timeout for web tools.
XIAOZHI_WEB_TOOL_TIMEOUT_SEC=15
# Max webpage text characters returned to the model.
XIAOZHI_WEB_TOOL_TEXT_LIMIT=6000
# Max links returned per fetched webpage.
XIAOZHI_WEB_TOOL_LINK_LIMIT=30
# Max web search results returned per search.
XIAOZHI_WEB_SEARCH_RESULT_LIMIT=5
# Google Programmable Search JSON API key for search_type=sites.
XIAOZHI_GOOGLE_SEARCH_API_KEY=
# Google Programmable Search Engine ID (cx) for search_type=sites.
XIAOZHI_GOOGLE_SEARCH_ENGINE_ID=

# ============ Raspberry Pi Camera MCP Tool ============
# Capture a JPEG and upload it to the vision endpoint supplied by the server.
XIAOZHI_CAMERA_TOOL_ENABLED=false
# Optional command override; empty auto-detects rpicam-still/libcamera-still.
XIAOZHI_CAMERA_COMMAND=
# Optional live-view command override; empty auto-detects rpicam-vid/libcamera-vid.
XIAOZHI_CAMERA_VIEWFINDER_COMMAND=
XIAOZHI_CAMERA_INDEX=0
XIAOZHI_CAMERA_WIDTH=1280
XIAOZHI_CAMERA_HEIGHT=960
XIAOZHI_CAMERA_QUALITY=90
XIAOZHI_CAMERA_WARMUP_MS=2000
XIAOZHI_CAMERA_TIMEOUT_SEC=15
XIAOZHI_CAMERA_VISION_TIMEOUT_SEC=60
XIAOZHI_CAMERA_VIEWFINDER_WIDTH=640
XIAOZHI_CAMERA_VIEWFINDER_HEIGHT=480
XIAOZHI_CAMERA_VIEWFINDER_FPS=5
XIAOZHI_CAMERA_VIEWFINDER_QUALITY=75
XIAOZHI_CAMERA_VIEWFINDER_READY_TIMEOUT_SEC=10
XIAOZHI_CAMERA_MAX_FRAME_BYTES=2097152
XIAOZHI_CAMERA_OUTPUT_DIR=data/camera
XIAOZHI_CAMERA_KEEP_CAPTURES=10
# Camera Module 3/IMX708: focus immediately before each still capture.
XIAOZHI_CAMERA_AUTOFOCUS=true
XIAOZHI_CAMERA_AUTOFOCUS_RANGE=full
XIAOZHI_CAMERA_AUTOFOCUS_SPEED=fast
# Seconds to show the captured image on the LCD before restoring the UI.
XIAOZHI_CAMERA_PREVIEW_SECONDS=2
# Manual camera flow: double-click to enter viewfinder, single-click to capture.
XIAOZHI_CAMERA_DOUBLE_CLICK_SECONDS=0.38
XIAOZHI_CAMERA_USER_PHOTO_PREVIEW_SECONDS=2
